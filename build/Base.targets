<Project>
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Company>Deltares</Company>
    <Copyright>Copyright © Stichting Deltares and State of the Netherlands 2026</Copyright>
    <VersionBase>26.1.1</VersionBase>
    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <PreRelease Condition="'$(PreRelease)' == ''">true</PreRelease>
    <PreReleaseLabel Condition="'$(PreReleaseLabel)' == ''">dev</PreReleaseLabel>
    <VersionPrefix>$(VersionBase)</VersionPrefix>
    <VersionSuffix Condition="'$(PreRelease)' == 'true'">$(PreReleaseLabel).$(BuildNumber)</VersionSuffix>
    <AssemblyVersion>$(VersionBase).$(BuildNumber)</AssemblyVersion>
    <FileVersion>$(VersionBase).$(BuildNumber)</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)Assembly.Kernel.licenseheader">
      <Link>Assembly.Kernel.licenseheader</Link>
    </None>
  </ItemGroup>
</Project>