<Project>
  <Import Project="$(SolutionDir)build\Base.targets" />
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1001</NoWarn> <!-- "Types that own disposable fields should be disposable" -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="NUnit" Version="5.0.0"/>
  </ItemGroup>
</Project>